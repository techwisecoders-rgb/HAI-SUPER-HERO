# --- Supabase ---
# Public (browser-safe) — used by the Supabase client in the browser for anon reads/inserts.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Server-only. NEVER prefix with NEXT_PUBLIC_. Used by Route Handlers for admin ops.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- App ---
# Public site URL (used for absolute links in admin emails, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Comma-separated list of e-mail addresses that may use the admin
# dashboard. When set it is the authoritative admin allow-list; when unset,
# any Supabase Auth account without an explicit non-admin role is allowed
# (matching the existing `public.is_admin()` behaviour).
# ADMIN_EMAILS=admin@yourcompany.com

# Optional overrides (defaults match the original app):
# NEXT_PUBLIC_CONTACT_PHONE=9963935878
# NEXT_PUBLIC_CONTACT_EMAIL=heawen.ias14319@gmail.com

# --- Telegram ---
# Server-only. Every new visitor message is pushed to this Telegram chat.
#
#   TELEGRAM_BOT_TOKEN — the token @BotFather gave you (e.g. 123456789:AA...)
#   TELEGRAM_CHAT_ID  — the chat that should receive the notifications.
#
# To find your chat id: send any message to your bot (or add it to a group),
# then open https://api.telegram.org/bot<TOKEN>/getUpdates and copy
# `result[].message.chat.id`. A comma separated list delivers to several
# chats at once (e.g. "5987654321,-1001234567890").
TELEGRAM_BOT_TOKEN=123456789:AA...
TELEGRAM_CHAT_ID=5987654321

# Optional. Set to "false" to stop mirroring admin replies to Telegram.
# (Visitor messages are always sent.)
# TELEGRAM_NOTIFY_ADMIN_REPLIES=true
